# Plasmo 开发环境默认（pnpm dev，NODE_ENV=development）
# API / 官网 两套独立环境开关（lib/env.ts），未设按 NODE_ENV 推断 dev→local
# local = 本地（API:localhost:8080 / 官网:localhost:5173）
# prod  = 生产（API:api.ouu365.com / 官网:www.ouu365.com）

# 后端 API 环境（默认 local；想连生产后端改 prod）
PLASMO_PUBLIC_API_ENV=local

# 官网环境（默认 local；菜单跳生产官网改 prod）
# 官网已发布生产，菜单始终指生产官网真实内容（文档/FAQ/反馈/联系）
PLASMO_PUBLIC_SITE_ENV=prod

# 高级单地址覆盖（罕用，优先级最高，覆盖上面的环境开关）：
# PLASMO_PUBLIC_API_BASE=https://api.ouu365.com/ouu-api
# PLASMO_PUBLIC_SITE_BASE=https://www.ouu365.com
# PLASMO_PUBLIC_MENU_SITE=https://www.ouu365.com
