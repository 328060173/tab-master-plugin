# Plasmo 开发环境配置（dev：跑 pnpm dev / pnpm dev:safe 时自动加载）
# 这是公开配置（无密钥），必须提交，让团队/CI 能复现开发环境。
# 本地临时覆盖：建 .env.local 改对应变量（.env.local 被 .gitignore 忽略，不提交）。

# 后端 API 地址（本地联调后端）
PLASMO_PUBLIC_API_BASE=http://localhost:8080/ouu-api

# 官网地址（本地联调 VitePress）
PLASMO_PUBLIC_SITE_BASE=http://localhost:5173

# 设置菜单默认项 URL（菜单给用户看真实官网内容，本地也指生产官网）
PLASMO_PUBLIC_MENU_SITE=https://www.ouu365.com
