# Plasmo 开发环境默认（pnpm dev，NODE_ENV=development）
# APP_ENV 显式声明（lib/env.ts 在 NODE_ENV=development 时已默认 local，此行仅为可读性/可覆盖）
PLASMO_PUBLIC_APP_ENV=local

# 想本地 dev 连生产后端，取消下一行注释（只覆盖 API，官网仍走本地）：
# PLASMO_PUBLIC_API_BASE=https://api.ouu365.com/ouu-api

# 想本地 dev 菜单跳生产官网（而非本地 dev server），取消下一行注释：
# PLASMO_PUBLIC_MENU_SITE=https://www.ouu365.com
