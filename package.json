{
  "name": "tab-master-plugin",
  "displayName": "浏览器标签大师",
  "version": "1.3.1",
  "description": "高效管理浏览器标签，一键备份防丢失",
  "short_name": "浏览器标签大师",
  "author": "xpd",
  "scripts": {
    "dev": "node scripts/sync-locales.js --watch & plasmo dev",
    "dev:safe": "pkill -f 'plasmo dev' || true; pkill -f 'sync-locales' || true && node scripts/sync-locales.js --watch & plasmo dev",
    "fresh": "pkill -f plasmo || true; pkill -f sync-locales || true; rm -rf .plasmo build && node scripts/sync-locales.js --watch & plasmo dev",
    "build": "plasmo build && node scripts/sync-locales.js",
    "package": "plasmo package",
    "clean": "rm -rf build",
    "kill-dev": "pkill -f 'plasmo dev' || true; pkill -f 'sync-locales' || true; echo '✅ 无残留进程'",
    "build:all": "node scripts/build.js"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "pinyin-pro": "^3.28.1",
    "plasmo": "0.90.5",
    "vue": "3.4.15"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "5.3.3",
    "crx3": "^2.0.0"
  },
  "manifest": {
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "default_locale": "zh_CN",
    "short_name": "__MSG_shortName__",
    "minimum_chrome_version": "114",
    "host_permissions": [
      "https://api.ouu365.com/*",
      "https://www.ouu365.com/*"
    ],
    "permissions": [
      "tabs",
      "tabGroups",
      "storage",
      "sidePanel",
      "alarms"
    ],
    "optional_permissions": [
      "history"
    ],
    "commands": {
      "switch-tab-1": {
        "suggested_key": {
          "default": "Alt+Shift+1",
          "mac": "Alt+Shift+1",
          "windows": "Alt+Shift+1",
          "linux": "Alt+Shift+1"
        },
        "description": "__MSG_cmdSwitchTab1__"
      },
      "switch-tab-2": {
        "suggested_key": {
          "default": "Alt+Shift+2",
          "mac": "Alt+Shift+2",
          "windows": "Alt+Shift+2",
          "linux": "Alt+Shift+2"
        },
        "description": "__MSG_cmdSwitchTab2__"
      },
      "switch-tab-3": {
        "suggested_key": {
          "default": "Alt+Shift+3",
          "mac": "Alt+Shift+3",
          "windows": "Alt+Shift+3",
          "linux": "Alt+Shift+3"
        },
        "description": "__MSG_cmdSwitchTab3__"
      },
      "switch-tab-4": {
        "suggested_key": {
          "default": "Alt+Shift+4",
          "mac": "Alt+Shift+4",
          "windows": "Alt+Shift+4",
          "linux": "Alt+Shift+4"
        },
        "description": "__MSG_cmdSwitchTab4__"
      }
    }
  }
}
