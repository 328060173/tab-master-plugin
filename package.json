{
  "name": "tab-master-plugin",
  "displayName": "TM-浏览器标签整理大师",
  "version": "1.1.0",
  "description": "3秒找到任何标签，标签再多也不乱。侧边栏标签管理：四视图、域名归并与最近访问优先排序、标记分类、聚焦模式、稍后处理、状态感知。Chrome/Edge。",
  "short_name": "TM-标签整理大师",
  "author": "xpd",
  "scripts": {
    "dev": "node scripts/sync-locales.js --watch & plasmo dev",
    "dev:safe": "pkill -f 'plasmo dev' || true; pkill -f 'sync-locales' || true && node scripts/sync-locales.js --watch & plasmo dev",
    "fresh": "pkill -f plasmo || true; pkill -f sync-locales || true; rm -rf .plasmo build && node scripts/sync-locales.js --watch & plasmo dev",
    "build": "plasmo build && node scripts/sync-locales.js",
    "package": "plasmo package",
    "clean": "rm -rf build",
    "kill-dev": "pkill -f 'plasmo dev' || true; pkill -f 'sync-locales' || true; echo '✅ 无残留进程'",
    "build:all": "node scripts/build.js"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "pinyin-pro": "^3.28.1",
    "plasmo": "0.90.5",
    "vue": "3.4.15"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "5.3.3",
    "crx3": "^2.0.0"
  },
  "manifest": {
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "default_locale": "zh_CN",
    "short_name": "TM-标签整理大师",
    "minimum_chrome_version": "114",
    "host_permissions": [
      "https://api.ouu365.com/*",
      "https://www.ouu365.com/*"
    ],
    "permissions": [
      "tabs",
      "tabGroups",
      "storage",
      "sidePanel",
      "alarms"
    ],
    "optional_permissions": [
      "history"
    ],
    "commands": {
      "switch-tab-1": {
        "suggested_key": {
          "default": "Alt+Shift+1",
          "mac": "Alt+Shift+1",
          "windows": "Alt+Shift+1",
          "linux": "Alt+Shift+1"
        },
        "description": "切换到编号 1 的标签"
      },
      "switch-tab-2": {
        "suggested_key": {
          "default": "Alt+Shift+2",
          "mac": "Alt+Shift+2",
          "windows": "Alt+Shift+2",
          "linux": "Alt+Shift+2"
        },
        "description": "切换到编号 2 的标签"
      },
      "switch-tab-3": {
        "suggested_key": {
          "default": "Alt+Shift+3",
          "mac": "Alt+Shift+3",
          "windows": "Alt+Shift+3",
          "linux": "Alt+Shift+3"
        },
        "description": "切换到编号 3 的标签"
      },
      "switch-tab-4": {
        "suggested_key": {
          "default": "Alt+Shift+4",
          "mac": "Alt+Shift+4",
          "windows": "Alt+Shift+4",
          "linux": "Alt+Shift+4"
        },
        "description": "切换到编号 4 的标签"
      }
    }
  }
}
